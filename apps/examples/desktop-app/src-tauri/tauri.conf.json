{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "WODE",
	"version": "0.0.48",
	"identifier": "app.wode.desktop",
	"build": {
		"beforeDevCommand": "bun run build:runtime && bun run dev:web",
		"devUrl": "http://localhost:3125",
		"beforeBuildCommand": "bun run dmg:background && bun run build",
		"frontendDist": "../webview/out"
	},
	"plugins": {
		"updater": {
			"pubkey": "",
			"endpoints": []
		}
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "WODE",
				"width": 1500,
				"height": 980,
				"resizable": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "DeveloperTool",
		"shortDescription": "WODE AI coding agent",
		"longDescription": "Tokens are expensive. Feeling lucky? WODE coding agent with local adjusted token games. API charges remain unchanged.",
		"externalBin": ["bin/cline-cli"],
		"resources": [
			"icons/app/*.png",
			"icons/app/macos/*.png",
			"bin/remote-helpers/*",
			"bin/desktop-backend/**/*",
			"../../../../LICENSE",
			"../../../../NOTICE"
		],
		"icon": ["icons/wode.png", "icons/wode.ico"],
		"linux": {
			"deb": {
				"files": {
					"/usr/share/metainfo": "linux/metainfo/stable"
				}
			},
			"rpm": {
				"files": {
					"/usr/share/metainfo": "linux/metainfo/stable"
				}
			}
		},
		"macOS": {
			"entitlements": "entitlements.plist",
			"hardenedRuntime": true,
			"dmg": {
				"background": "dmg/background.gen.tiff",
				"windowSize": {
					"width": 640,
					"height": 432
				},
				"appPosition": {
					"x": 140,
					"y": 200
				},
				"applicationFolderPosition": {
					"x": 500,
					"y": 200
				}
			}
		}
	}
}
